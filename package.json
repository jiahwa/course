{
  "name": "course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "course · 多课程资料库",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node server/main.ts",
    "dev": "node --watch server/main.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "bench": "node .bench/bench.ts",
    "test": "node --test tests/*.test.ts",
    "sync": "node src/sync.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
